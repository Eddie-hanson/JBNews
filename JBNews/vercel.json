{
  "version": 2,
  "buildCommand": "bash build.sh",
  "installCommand": "pip install -r JBNews/requirements.txt",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
