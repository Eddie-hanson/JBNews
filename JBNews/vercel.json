{
  "version": 2,
  "build": {
    "env": {
      "DJANGO_SETTINGS_MODULE": "JBNews.productions_settings"
    }
  },
  "builds": [
    {
      "src": "JBNews/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.13"
      }
    },
    {
      "src": "build.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "JBNews/wsgi.py"
    }
  ]
}
