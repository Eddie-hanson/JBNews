{
  "version": 2,
  "builds": [
    {
      "src": "JBNews/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.13"
      }
    },
    {
      "src": "build.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "JBNews/staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "JBNews/wsgi.py"
    }
  ],
  "outputDirectory": "JBNews/staticfiles"
}
